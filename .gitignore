# Python virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# ChipWhisperer: allow only the STM32F303 AES build dependencies.
# Keep the complete local checkout, notebooks, tools, and generated files untracked.
/chipwhisperer/**
